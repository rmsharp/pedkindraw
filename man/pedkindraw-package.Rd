\title{pedkindraw: Interactive Pedigree Drawings and Kinship}
\description{
Draws pedigrees as interactive 'visNetwork' graphs that can be annotated, and computes kinship coefficients. It also trims and shrinks pedigrees, checks pedigree records, finds sets of unrelated individuals, and converts 'kinship2' 'pedigree' and 'Pedixplorer' 'Pedigree' objects.
}
\section{Drawing}{

\code{\link[=makePedigreeMatingLayout]{makePedigreeMatingLayout()}} lays out a pedigree's animals and matings,
with a twins table, a kinship matrix and layout hints, and
\code{\link[=drawPedigreeDiagram]{drawPedigreeDiagram()}} draws the layout as an interactive graph.
\code{\link[=makePedigreeDiagramData]{makePedigreeDiagramData()}} makes a simpler drawing's nodes and edges.
}

\section{Kinship and relatedness}{

\code{\link[=kinship]{kinship()}} computes the kinship matrix, \code{\link[=ibdMatrix]{ibdMatrix()}} builds an IBD matrix
from pairs of ids and their values, and \code{\link[=findUnrelated]{findUnrelated()}} finds a set of
unrelated genotyped animals.
}

\section{Pedigree structure}{

\code{\link[=findGeneration]{findGeneration()}}, \code{\link[=findPedigreeNumber]{findPedigreeNumber()}} and \code{\link[=familyCheck]{familyCheck()}} number and
check each animal's generation and family tree; \code{\link[=getParents]{getParents()}},
\code{\link[=getOffspring]{getOffspring()}}, \code{\link[=getFounders]{getFounders()}}, \code{\link[=isFounder]{isFounder()}}, \code{\link[=hasBothParents]{hasBothParents()}} and
\code{\link[=getIdsWithOneParent]{getIdsWithOneParent()}} find sires and dams, offspring and founders.
}

\section{Checking and repair}{

\code{\link[=checkPedigree]{checkPedigree()}} lists each problem in a pedigree and
\code{\link[=checkTwinRelations]{checkTwinRelations()}} checks a twins table; \code{\link[=addParents]{addParents()}},
\code{\link[=correctParentSex]{correctParentSex()}} and \code{\link[=addBackSecondParents]{addBackSecondParents()}} repair a pedigree.
}

